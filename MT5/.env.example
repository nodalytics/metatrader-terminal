# MetaTrader 5 Terminal Configuration
# -----------------------------------

# MT5 Login (Must be a number. Use 0 if not logged in)
MT5_LOGIN=0

# MT5 Account Password
MT5_PASSWORD="password"

# MT5 Broker Server Name (e.g., Deriv-Demo, IC-Markets-Demo)
MT5_SERVER="MetaTrader5-Demo"

# VNC Access (For viewing the terminal in a browser)
VNC_USER=mt5_user
VNC_PASSWORD=password

# Which MetaTrader 5 installer to fetch. Leave unset for whatever MetaQuotes
# currently publishes, which is the default and usually what you want.
#
# Set it to a versioned installer to pin a build - worth doing only when you are
# testing whether a specific terminal build is the cause of something, because a
# build has broken the Python binding's IPC before. The pin holds: run-mt5.sh
# disables LiveUpdate before the first launch, and /health reports the build that
# ended up installed.
# MT5_SETUP_URL=
