# MetaTrader 5 Terminal Configuration
# -----------------------------------

# MT5 Login (Must be a number. Use 0 if not logged in)
MT5_LOGIN=0

# MT5 Account Password
MT5_PASSWORD="password"

# MT5 Broker Server Name (e.g., Deriv-Demo, IC-Markets-Demo)
MT5_SERVER="MetaTrader5-Demo"

# Whether the API may start on a terminal that cannot place an order. The
# default, 1, refuses: the start-up chain confirms terminal_info().trade_allowed
# and the API does not serve until it does. Set it to 0 only for a deliberately
# read-only bridge - history and quotes work, every order is refused (10027).
MT5_REQUIRE_ALGO=1

# VNC Access (For viewing the terminal in a browser)
# Placeholders. This file is committed, so real values do not belong here.
VNC_USER=change-me
VNC_PASSWORD=change-me

# Which MetaTrader 5 installer to fetch. Leave unset for whatever MetaQuotes
# currently publishes, which is the default and usually what you want.
#
# Set it to a versioned installer to pin a build - worth doing only when you are
# testing whether a specific terminal build is the cause of something, because a
# build has broken the Python binding's IPC before. The pin holds: run-mt5.sh
# disables LiveUpdate before the first launch, and /health reports the build that
# ended up installed.
# MT5_SETUP_URL=

# ──── the EA tick feed ────
#
# `MT5/ea/TillTickFeed.mq5` pushes every tick out of the terminal to a listener
# inside this container, and `/api/v1/stream` relays it. Without an EA attached
# the stream polls `symbol_info_tick` on a timer, which is a *sample*: a quote
# that moved and moved back between two polls never happened as far as a
# consumer is concerned, and no interval fixes that.
#
# Loopback by default and deliberately. The listener treats whatever connects
# to it as a tick producer - there is no authentication on a socket the
# terminal opens from inside this container - so it must not be reachable from
# outside it.
# EA_FEED_ENABLED=true
# EA_FEED_HOST=127.0.0.1
# EA_FEED_PORT=18823

# --- Where the terminal is -------------------------------------------------
# inprocess (default) imports the MetaTrader5 package and talks to a terminal
# on this machine. That is what every existing deployment runs and it is
# microseconds; the API lives in the terminal's container because the package
# is win32-only.
#
# rpyc proxies a terminal elsewhere. It is NOT faster - an in-process call has
# no hop to remove - it buys *where the API may run*: outside the Wine
# container, or one API against several terminals.
#
# The channel is plaintext and unauthenticated, so a non-loopback host is
# refused unless MT5_RPYC_ALLOW_REMOTE=1. Reach a remote terminal through an
# SSH tunnel to 127.0.0.1, which is how the rest of this stack does it.
# MT5_TRANSPORT=inprocess
# MT5_RPYC_HOST=127.0.0.1
# MT5_RPYC_PORT=18812
# MT5_RPYC_TIMEOUT_S=30
# MT5_RPYC_ALLOW_REMOTE=0
