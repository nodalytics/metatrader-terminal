# --- MetaTrader 5 Connection ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server
MT5_API_PORT=8000

# Auth Configuration
API_KEY_SEED=your_super_secret_admin_seed_here

# --- Strategy Settings ---
LEVERAGE=200
DEVIATION=20

# --- Database (SQLite) ---
# Use a relative path within the app directory, mapped to a docker volume for persistence
DATABASE_URL=sqlite:///./mt5_api/data/database.db

# --- Where the terminal is -------------------------------------------------
# inprocess (default) imports the MetaTrader5 package and talks to a terminal
# on this machine. That is what every existing deployment runs and it is
# microseconds; the API lives in the terminal's container because the package
# is win32-only.
#
# rpyc proxies a terminal elsewhere. It is NOT faster - an in-process call has
# no hop to remove - it buys *where the API may run*: outside the Wine
# container, or one API against several terminals.
#
# The channel is plaintext and unauthenticated, so a non-loopback host is
# refused unless MT5_RPYC_ALLOW_REMOTE=1. Reach a remote terminal through an
# SSH tunnel to 127.0.0.1, which is how the rest of this stack does it.
# MT5_TRANSPORT=inprocess
# MT5_RPYC_HOST=127.0.0.1
# MT5_RPYC_PORT=18812
# MT5_RPYC_TIMEOUT_S=30
# MT5_RPYC_ALLOW_REMOTE=0
